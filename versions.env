: "${LB_VERSION=2.1.04}"
if [[ ! ${LB_WIN_SHA256+x} ]]; then
  case "$LB_VERSION" in
    2.1.04) LB_WIN_SHA256=1209eb5c8467a9aefa4eabbace5e982e232f8352db24797bb01f56671299b17b ;;
    2.1.00) LB_WIN_SHA256=00b22facdd24465195a1ce8e92546a9580d216c76ee1c82e505519b7ebcbd8ce ;;
    2.0.05) LB_WIN_SHA256=12207cf2ee9700a940f87bea424cdc3edaa8ff1476671a43f7547ef136b10df4 ;;
    *) LB_WIN_SHA256= ;;
  esac
fi
: "${TESTED_WINE_VERSION=11.17}"
: "${WINEARCH=win64}"
